{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "functions": {
    "api/cron/*.js": {
      "maxDuration": 60
    },
    "api/oportunidades/*.js": {
      "maxDuration": 60
    },
    "api/webhooks/*.js": {
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/cron/clientify-conciliacion",
      "schedule": "0 7 * * *"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
